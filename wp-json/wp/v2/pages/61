\n<span style=\"display:flex;align-items:center;gap:10px;font:400 13.5px\/1 Helvetica,Arial,sans-serif;color:#4A5438\"><i class=\"fa-solid fa-face-smile\" style=\"font-size:11px;color:#C2A469\"><\/i>Beautiful, lasting results<\/span>\r\n<\/div>\r\n<\/div>\r\n<\/div>\r\n<\/section>\r\n\r\n\r\n<!-- ===== BOOKING WIDGET: styles and logic =====================\r\n     Everything the calendar and the two forms need lives in this one\r\n     block, so nothing has to be enqueued anywhere else. The plugin is\r\n     still required, but only for the back end: it stores the bookings,\r\n     locks the slots and sends the mail.\r\n     ========================================================== -->\r\n<style>\r\n\/* Braces & Beyond \u2014 booking calendar and forms.\r\n   Every value is taken from the existing site design system so the widget sits\r\n   inside the page without looking bolted on:\r\n     sage #576045 \/ deep #3E4530 \/ gold #C2A469 \/ cream #FAF8F2 \/ card #FFFDF7 *\/\r\n\r\n.bbb {\r\n\t--bbb-sage: #576045;\r\n\t--bbb-deep: #3E4530;\r\n\t--bbb-olive: #4A5438;\r\n\t--bbb-gold: #C2A469;\r\n\t--bbb-gold-soft: #DCC79B;\r\n\t--bbb-cream: #FAF8F2;\r\n\t--bbb-card: #FFFDF7;\r\n\t--bbb-line: #EBE5D4;\r\n\t--bbb-ink: #5C5E54;\r\n\t--bbb-mute: #7C8074;\r\n\tfont: 400 16px\/1.6 Helvetica, Arial, sans-serif;\r\n\tcolor: var(--bbb-ink);\r\n\ttext-align: left;\r\n\tbox-sizing: border-box;\r\n}\r\n.bbb *, .bbb *::before, .bbb *::after { box-sizing: border-box; }\r\n.bbb p { margin: 0; }\r\n\r\n.bbb-card {\r\n\tbackground: rgba(255, 253, 247, .9);\r\n\tborder: 1px solid rgba(220, 199, 155, .55);\r\n\tborder-radius: 24px;\r\n\tpadding: clamp(20px, 3vw, 30px);\r\n\tbox-shadow: 0 1px 0 #fff inset, 0 34px 70px -40px rgba(87, 96, 69, .55);\r\n}\r\n\r\n.bbb-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; margin-bottom: 6px; }\r\n.bbb-head h2 { margin: 0; font: 400 clamp(21px, 2.4vw, 26px)\/1.2 Helvetica, Arial, sans-serif; letter-spacing: -.022em; color: var(--bbb-sage); }\r\n.bbb-bar { display: block; width: 46px; height: 2px; background: var(--bbb-gold); margin: 12px 0 16px; }\r\n.bbb-lede { font-size: 15px; line-height: 1.7; color: var(--bbb-ink); }\r\n\r\n\/* ---- steps -------------------------------------------------------------- *\/\r\n.bbb-steps { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 22px; }\r\n.bbb-step {\r\n\tdisplay: inline-flex; align-items: center; gap: 9px;\r\n\tpadding: 9px 15px; border-radius: 999px;\r\n\tborder: 1px solid var(--bbb-line); background: var(--bbb-card);\r\n\tfont-size: 12.5px; line-height: 1; color: var(--bbb-mute);\r\n\ttransition: background .3s, color .3s, border-color .3s;\r\n}\r\n.bbb-step b { font-weight: 400; }\r\n.bbb-step-n { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; border-radius: 50%; background: #EFEDE0; color: var(--bbb-olive); font-size: 11px; }\r\n.bbb-step.is-done { border-color: var(--bbb-gold-soft); color: var(--bbb-olive); }\r\n.bbb-step.is-done .bbb-step-n { background: var(--bbb-gold); color: #39422C; }\r\n.bbb-step.is-now { background: var(--bbb-sage); border-color: var(--bbb-sage); color: #FAF8F2; }\r\n.bbb-step.is-now .bbb-step-n { background: rgba(250, 248, 242, .22); color: #FAF8F2; }\r\n\r\n\/* ---- calendar ----------------------------------------------------------- *\/\r\n.bbb-cal { margin-top: 4px; }\r\n.bbb-cal-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }\r\n.bbb-month { font: 400 18px\/1.2 Helvetica, Arial, sans-serif; color: var(--bbb-deep); }\r\n.bbb-nav { display: flex; gap: 8px; }\r\n.bbb-nav button {\r\n\twidth: 40px; height: 40px; border-radius: 50%;\r\n\tborder: 1px solid var(--bbb-line); background: var(--bbb-card);\r\n\tcolor: var(--bbb-sage); font-size: 15px; line-height: 1; cursor: pointer;\r\n\ttransition: background .25s, color .25s, border-color .25s;\r\n}\r\n.bbb-nav button:hover:not(:disabled) { background: var(--bbb-sage); color: var(--bbb-cream); border-color: var(--bbb-sage); }\r\n.bbb-nav button:disabled { opacity: .35; cursor: not-allowed; }\r\n\r\n.bbb-dow, .bbb-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; }\r\n.bbb-dow span { text-align: center; font: 500 10.5px\/1 Helvetica, Arial, sans-serif; letter-spacing: .14em; text-transform: uppercase; color: var(--bbb-mute); padding: 8px 0; }\r\n\r\n.bbb-day {\r\n\tposition: relative; display: flex; flex-direction: column; align-items: center; justify-content: center;\r\n\tgap: 3px; min-height: 52px; padding: 6px 2px;\r\n\tborder: 1px solid var(--bbb-line); border-radius: 14px;\r\n\tbackground: var(--bbb-card); color: var(--bbb-deep);\r\n\tfont: 400 15px\/1 Helvetica, Arial, sans-serif; cursor: pointer;\r\n\ttransition: background .25s, color .25s, border-color .25s, transform .25s;\r\n}\r\n.bbb-day:hover:not(:disabled) { border-color: var(--bbb-gold); transform: translateY(-2px); }\r\n.bbb-day .bbb-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--bbb-gold); }\r\n.bbb-day:disabled { cursor: not-allowed; background: transparent; border-color: #F0EDE2; color: #BFC0B4; }\r\n.bbb-day.is-empty { border: none; background: none; cursor: default; }\r\n.bbb-day.is-full { background: repeating-linear-gradient(135deg, #F3F0E6, #F3F0E6 5px, #FAF8F2 5px, #FAF8F2 10px); color: #A9AA9C; }\r\n.bbb-day.is-today { box-shadow: 0 0 0 1px var(--bbb-gold-soft) inset; }\r\n.bbb-day.is-on { background: var(--bbb-sage); border-color: var(--bbb-sage); color: var(--bbb-cream); }\r\n.bbb-day.is-on .bbb-dot { background: var(--bbb-gold-soft); }\r\n\r\n.bbb-legend { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 14px; font-size: 12px; color: var(--bbb-mute); }\r\n.bbb-legend span { display: inline-flex; align-items: center; gap: 7px; }\r\n.bbb-key { width: 12px; height: 12px; border-radius: 4px; border: 1px solid var(--bbb-line); background: var(--bbb-card); }\r\n.bbb-key.full { background: repeating-linear-gradient(135deg, #F3F0E6, #F3F0E6 4px, #FAF8F2 4px, #FAF8F2 8px); }\r\n.bbb-key.closed { background: transparent; border-color: #F0EDE2; }\r\n\r\n\/* ---- slots -------------------------------------------------------------- *\/\r\n.bbb-slots { margin-top: 26px; padding-top: 24px; border-top: 1px solid var(--bbb-line); }\r\n.bbb-slots h3 { margin: 0 0 4px; font: 400 18px\/1.3 Helvetica, Arial, sans-serif; color: var(--bbb-deep); }\r\n.bbb-slots-sub { font-size: 13.5px; color: var(--bbb-mute); margin-bottom: 18px; }\r\n.bbb-group { margin-bottom: 18px; }\r\n.bbb-group-t { font: 500 10.5px\/1 Helvetica, Arial, sans-serif; letter-spacing: .18em; text-transform: uppercase; color: #B2934F; margin-bottom: 12px; }\r\n.bbb-times { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 10px; }\r\n.bbb-time {\r\n\tpadding: 13px 8px; border-radius: 12px;\r\n\tborder: 1px solid var(--bbb-line); background: var(--bbb-card);\r\n\tcolor: var(--bbb-olive); font: 400 14.5px\/1 Helvetica, Arial, sans-serif;\r\n\tcursor: pointer; min-height: 46px;\r\n\ttransition: background .25s, color .25s, border-color .25s, transform .25s;\r\n}\r\n.bbb-time:hover:not(:disabled) { border-color: var(--bbb-gold); transform: translateY(-2px); }\r\n.bbb-time:disabled { color: #B7B8AB; background: transparent; border-color: #F0EDE2; cursor: not-allowed; text-decoration: line-through; }\r\n.bbb-time.is-on { background: var(--bbb-sage); border-color: var(--bbb-sage); color: var(--bbb-cream); box-shadow: 0 14px 26px -16px rgba(87, 96, 69, .9); }\r\n\r\n\/* ---- form --------------------------------------------------------------- *\/\r\n.bbb-form { margin-top: 26px; padding-top: 24px; border-top: 1px solid var(--bbb-line); }\r\n.bbb-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }\r\n.bbb-field.is-wide { grid-column: 1 \/ -1; }\r\n.bbb-field label { display: block; font: 500 11px\/1 Helvetica, Arial, sans-serif; letter-spacing: .14em; text-transform: uppercase; color: var(--bbb-mute); margin-bottom: 9px; }\r\n.bbb-field input, .bbb-field select, .bbb-field textarea {\r\n\twidth: 100%; padding: 14px 16px; min-height: 50px;\r\n\tborder: 1px solid var(--bbb-line); border-radius: 12px;\r\n\tbackground: #fff; color: #3E4530;\r\n\tfont: 400 15px\/1.4 Helvetica, Arial, sans-serif;\r\n\ttransition: border-color .25s, box-shadow .25s;\r\n}\r\n.bbb-field textarea { min-height: 96px; resize: vertical; }\r\n.bbb-field input:focus, .bbb-field select:focus, .bbb-field textarea:focus {\r\n\toutline: none; border-color: var(--bbb-sage); box-shadow: 0 0 0 3px rgba(87, 96, 69, .12);\r\n}\r\n.bbb-field.has-error input, .bbb-field.has-error select, .bbb-field.has-error textarea { border-color: #B4574A; }\r\n.bbb-hint { margin-top: 7px; font-size: 12.5px; color: var(--bbb-mute); }\r\n\r\n.bbb-consent { display: flex; align-items: flex-start; gap: 12px; margin-top: 18px; font-size: 14px; line-height: 1.6; color: var(--bbb-ink); }\r\n.bbb-consent input { width: 20px; height: 20px; margin-top: 2px; flex: 0 0 auto; accent-color: #576045; }\r\n\r\n.bbb-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }\r\n\r\n.bbb-actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 22px; }\r\n.bbb-btn {\r\n\tdisplay: inline-flex; align-items: center; justify-content: center; gap: 10px;\r\n\tpadding: 17px 30px; min-height: 52px; border-radius: 999px;\r\n\tborder: 1px solid transparent; cursor: pointer;\r\n\tfont: 500 15px\/1 Helvetica, Arial, sans-serif;\r\n\ttext-decoration: none; transition: background .3s, color .3s, transform .3s, box-shadow .3s;\r\n}\r\n.bbb-btn-p { background: var(--bbb-sage); color: var(--bbb-cream); box-shadow: 0 18px 40px -22px rgba(87, 96, 69, .95); }\r\n.bbb-btn-p:hover:not(:disabled) { background: var(--bbb-deep); transform: translateY(-2px); color: var(--bbb-cream); }\r\n.bbb-btn-s { background: rgba(255, 253, 247, .7); border-color: var(--bbb-gold); color: var(--bbb-sage); }\r\n.bbb-btn-s:hover { background: var(--bbb-sage); color: var(--bbb-cream); }\r\n.bbb-btn:disabled { opacity: .6; cursor: wait; }\r\n\r\n\/* ---- messages ----------------------------------------------------------- *\/\r\n.bbb-alert { display: none; margin-top: 16px; padding: 14px 18px; border-radius: 14px; font-size: 14.5px; line-height: 1.6; }\r\n.bbb-alert.is-on { display: block; }\r\n.bbb-alert-err { background: #FAEDEA; border: 1px solid #E8CFC8; color: #8A3B2C; }\r\n.bbb-alert-info { background: #F1F3EA; border: 1px solid #DFE3D2; color: #4A5438; }\r\n\r\n.bbb-note { margin-top: 18px; font-size: 13px; line-height: 1.7; color: var(--bbb-mute); }\r\n\r\n.bbb-loading { display: flex; align-items: center; gap: 12px; padding: 22px 0; font-size: 14px; color: var(--bbb-mute); }\r\n.bbb-spin { width: 18px; height: 18px; border-radius: 50%; border: 2px solid #E4E0D0; border-top-color: var(--bbb-gold); animation: bbbSpin .8s linear infinite; }\r\n@keyframes bbbSpin { to { transform: rotate(360deg); } }\r\n\r\n\/* ---- success ------------------------------------------------------------ *\/\r\n.bbb-done { text-align: center; padding: 8px 0 4px; }\r\n.bbb-tick { width: 68px; height: 68px; margin: 0 auto 20px; border-radius: 50%; background: linear-gradient(160deg, #5A6645, #414B33); color: #E6D9B4; display: flex; align-items: center; justify-content: center; font-size: 28px; box-shadow: 0 18px 32px -18px rgba(35, 36, 31, .8); }\r\n.bbb-done h3 { margin: 0 0 12px; font: 400 clamp(22px, 2.6vw, 28px)\/1.25 Helvetica, Arial, sans-serif; color: var(--bbb-deep); }\r\n.bbb-done p { max-width: 46ch; margin: 0 auto; font-size: 15px; line-height: 1.75; color: var(--bbb-ink); }\r\n.bbb-receipt { max-width: 420px; margin: 22px auto 0; border: 1px solid var(--bbb-line); border-radius: 16px; overflow: hidden; text-align: left; }\r\n.bbb-receipt div { display: flex; justify-content: space-between; gap: 16px; padding: 13px 18px; border-bottom: 1px solid var(--bbb-line); font-size: 14.5px; }\r\n.bbb-receipt div:last-child { border-bottom: none; }\r\n.bbb-receipt span:first-child { color: var(--bbb-mute); }\r\n.bbb-receipt span:last-child { color: var(--bbb-deep); text-align: right; }\r\n.bbb-done .bbb-actions { justify-content: center; }\r\n\r\n\/* ---- responsive --------------------------------------------------------- *\/\r\n@media (max-width: 680px) {\r\n\t.bbb-fields { grid-template-columns: 1fr; }\r\n\t.bbb-day { min-height: 46px; font-size: 14px; border-radius: 12px; }\r\n\t.bbb-dow, .bbb-grid { gap: 5px; }\r\n\t.bbb-times { grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); }\r\n\t.bbb-actions .bbb-btn { width: 100%; }\r\n\t.bbb-card { padding: 20px 16px; border-radius: 20px; }\r\n\t.bbb-steps { gap: 6px; }\r\n\t.bbb-step { font-size: 11.5px; padding: 8px 12px; }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n\t.bbb *, .bbb *::before, .bbb *::after { transition: none !important; animation: none !important; }\r\n}\r\n\r\n.bbb a:focus-visible, .bbb button:focus-visible, .bbb input:focus-visible, .bbb select:focus-visible, .bbb textarea:focus-visible {\r\n\toutline: 2px solid var(--bbb-sage); outline-offset: 3px; border-radius: 8px;\r\n}\r\n<\/style>\r\n\r\n<script>\r\n\/* Braces & Beyond \u2014 booking calendar and forms.\r\n *\r\n * Mounts into any element carrying data-bb-booking or data-bb-enquiry.\r\n * No dependencies, no build step. Everything talks to the plugin REST API.\r\n *\/\r\n(function () {\r\n\t'use strict';\r\n\r\n\t\/* ---- CONFIG -------------------------------------------------------\r\n\t   The only block you ever need to edit on this page. Everything else\r\n\t   is logic. The reasons list only fills the dropdown; the server does\r\n\t   not validate it, so it can be changed here freely.\r\n\t   ------------------------------------------------------------------ *\/\r\n\tvar C = {\r\n\t\trest: 'https:\/\/thebracesandbeyond.com\/wp-json\/bbb\/v1',\r\n\t\tclinic: 'Braces & Beyond',\r\n\t\taddress: 'Roman Grove II, First Floor, DHA 1, Sector F, Islamabad',\r\n\t\tphone: '0319 9911941',\r\n\t\twhatsapp: '923199911941',\r\n\t\tminutes: 30,\r\n\t\trequireMail: 0,\r\n\t\tnote: 'Reception will call you to confirm this appointment before your visit.',\r\n\t\tservices: [\r\n\t\t\t'Orthodontic consultation',\r\n\t\t\t'Braces or clear aligners',\r\n\t\t\t'Restorative and endodontics',\r\n\t\t\t'Prosthodontics',\r\n\t\t\t'Periodontics',\r\n\t\t\t'Oral and maxillofacial surgery',\r\n\t\t\t'Second opinion',\r\n\t\t\t'Something else'\r\n\t\t],\r\n\t\tpage: location.href\r\n\t};\r\n\r\n\tvar DOW = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];\r\n\r\n\t\/* ------------------------------------------------------------------ *\r\n\t * small helpers\r\n\t * ------------------------------------------------------------------ *\/\r\n\r\n\tfunction pad(n) { return (n < 10 ? '0' : '') + n; }\r\n\r\n\tfunction ymd(d) { return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); }\r\n\r\n\tfunction esc(s) {\r\n\t\treturn String(s == null ? '' : s)\r\n\t\t\t.replace(\/&\/g, '&amp;').replace(\/<\/g, '&lt;').replace(\/>\/g, '&gt;')\r\n\t\t\t.replace(\/\"\/g, '&quot;').replace(\/'\/g, '&#39;');\r\n\t}\r\n\r\n\tfunction api(path, opts) {\r\n\t\topts = opts || {};\r\n\t\tvar init = {\r\n\t\t\tmethod: opts.method || 'GET',\r\n\t\t\tcredentials: 'same-origin',\r\n\t\t\theaders: { 'Content-Type': 'application\/json' }\r\n\t\t};\r\n\t\tif (opts.body) { init.body = JSON.stringify(opts.body); }\r\n\r\n\t\treturn fetch(C.rest + path, init).then(function (res) {\r\n\t\t\treturn res.text().then(function (raw) {\r\n\t\t\t\tvar json = {};\r\n\t\t\t\ttry { json = raw ? JSON.parse(raw) : {}; } catch (e) { json = {}; }\r\n\t\t\t\tif (!res.ok) {\r\n\t\t\t\t\tvar err = new Error(json.message || 'We could not reach the clinic calendar. Please try again.');\r\n\t\t\t\t\terr.code = json.code || '';\r\n\t\t\t\t\terr.status = res.status;\r\n\t\t\t\t\terr.field = (json.data && json.data.field) || '';\r\n\t\t\t\t\tthrow err;\r\n\t\t\t\t}\r\n\t\t\t\treturn json;\r\n\t\t\t});\r\n\t\t});\r\n\t}\r\n\r\n\t\/* ------------------------------------------------------------------ *\r\n\t * booking widget\r\n\t * ------------------------------------------------------------------ *\/\r\n\r\n\tfunction mountBooking(root) {\r\n\r\n\t\tif (root.getAttribute('data-bbb-ready')) { return; }\r\n\t\troot.setAttribute('data-bbb-ready', '1');\r\n\r\n\t\tvar title = root.getAttribute('data-bb-title') || 'Book a Consultation';\r\n\r\n\t\tvar state = {\r\n\t\t\tmonth: ymd(new Date()).slice(0, 7),\r\n\t\t\tmonthData: null,\r\n\t\t\tdate: null,\r\n\t\t\tday: null,\r\n\t\t\ttime: null,\r\n\t\t\topened: Date.now(),\r\n\t\t\tbusy: false\r\n\t\t};\r\n\r\n\t\troot.className = ((root.className || '') + ' bbb').trim();\r\n\t\troot.innerHTML = shell(title);\r\n\r\n\t\tvar el = {\r\n\t\t\tsteps: root.querySelector('[data-bbb=\"steps\"]'),\r\n\t\t\tmonth: root.querySelector('[data-bbb=\"month\"]'),\r\n\t\t\tprev: root.querySelector('[data-bbb=\"prev\"]'),\r\n\t\t\tnext: root.querySelector('[data-bbb=\"next\"]'),\r\n\t\t\tgrid: root.querySelector('[data-bbb=\"grid\"]'),\r\n\t\t\tslots: root.querySelector('[data-bbb=\"slots\"]'),\r\n\t\t\tform: root.querySelector('[data-bbb=\"form\"]'),\r\n\t\t\tbody: root.querySelector('[data-bbb=\"body\"]'),\r\n\t\t\tdone: root.querySelector('[data-bbb=\"done\"]'),\r\n\t\t\talert: root.querySelector('[data-bbb=\"alert\"]')\r\n\t\t};\r\n\r\n\t\tel.prev.addEventListener('click', function () { shiftMonth(-1); });\r\n\t\tel.next.addEventListener('click', function () { shiftMonth(1); });\r\n\r\n\t\tloadMonth(state.month);\r\n\t\tpaintSteps();\r\n\r\n\t\t\/* ---- month ---- *\/\r\n\r\n\t\tfunction shiftMonth(delta) {\r\n\t\t\tvar parts = state.month.split('-');\r\n\t\t\tvar d = new Date(+parts[0], +parts[1] - 1 + delta, 1);\r\n\t\t\tloadMonth(d.getFullYear() + '-' + pad(d.getMonth() + 1));\r\n\t\t}\r\n\r\n\t\tfunction loadMonth(ym) {\r\n\t\t\tel.grid.innerHTML = '<div class=\"bbb-loading\" style=\"grid-column:1\/-1\"><span class=\"bbb-spin\"><\/span> Loading available dates\u2026<\/div>';\r\n\t\t\tapi('\/month?month=' + encodeURIComponent(ym)).then(function (data) {\r\n\t\t\t\tstate.month = data.month;\r\n\t\t\t\tstate.monthData = data;\r\n\t\t\t\tpaintMonth();\r\n\t\t\t}).catch(function (e) {\r\n\t\t\t\tel.grid.innerHTML = '<p style=\"grid-column:1\/-1\" class=\"bbb-note\">' + esc(e.message) + '<\/p>';\r\n\t\t\t});\r\n\t\t}\r\n\r\n\t\tfunction paintMonth() {\r\n\t\t\tvar data = state.monthData;\r\n\t\t\tel.month.textContent = data.label;\r\n\r\n\t\t\tvar first = new Date(+data.month.split('-')[0], +data.month.split('-')[1] - 1, 1);\r\n\t\t\tvar lead = (first.getDay() + 6) % 7; \/\/ grid starts on Monday\r\n\t\t\tvar daysIn = new Date(first.getFullYear(), first.getMonth() + 1, 0).getDate();\r\n\t\t\tvar todayKey = data.min;\r\n\r\n\t\t\tvar html = '';\r\n\t\t\tfor (var i = 0; i < lead; i++) { html += '<span class=\"bbb-day is-empty\"><\/span>'; }\r\n\r\n\t\t\tfor (var d = 1; d <= daysIn; d++) {\r\n\t\t\t\tvar key = data.month + '-' + pad(d);\r\n\t\t\t\tvar info = data.days[key] || { status: 'closed', free: 0 };\r\n\t\t\t\tvar open = info.status === 'open';\r\n\t\t\t\tvar cls = 'bbb-day';\r\n\t\t\t\tvar note = '';\r\n\r\n\t\t\t\tif (info.status === 'full') { cls += ' is-full'; note = 'fully booked'; }\r\n\t\t\t\telse if (info.status === 'closed') { note = 'closed'; }\r\n\t\t\t\telse if (info.status === 'past') { note = 'past'; }\r\n\t\t\t\telse if (info.status === 'beyond') { note = 'not open yet'; }\r\n\t\t\t\telse { note = info.free + (info.free === 1 ? ' slot free' : ' slots free'); }\r\n\r\n\t\t\t\tif (key === todayKey) { cls += ' is-today'; }\r\n\t\t\t\tif (key === state.date) { cls += ' is-on'; }\r\n\r\n\t\t\t\thtml += '<button type=\"button\" class=\"' + cls + '\" data-date=\"' + key + '\"' +\r\n\t\t\t\t\t(open ? '' : ' disabled') +\r\n\t\t\t\t\t' aria-label=\"' + esc(d + ' ' + data.label + ', ' + note) + '\"' +\r\n\t\t\t\t\t' aria-pressed=\"' + (key === state.date ? 'true' : 'false') + '\">' +\r\n\t\t\t\t\t'<span>' + d + '<\/span>' +\r\n\t\t\t\t\t(open ? '<span class=\"bbb-dot\"><\/span>' : '') +\r\n\t\t\t\t\t'<\/button>';\r\n\t\t\t}\r\n\r\n\t\t\tel.grid.innerHTML = html;\r\n\r\n\t\t\t\/\/ The server tells us the first and last bookable day, so the arrows\r\n\t\t\t\/\/ can never walk outside the window the clinic actually opens.\r\n\t\t\tel.prev.disabled = (data.month <= String(data.min || '').slice(0, 7));\r\n\t\t\tel.next.disabled = (data.month >= String(data.max || '').slice(0, 7));\r\n\r\n\t\t\tArray.prototype.forEach.call(el.grid.querySelectorAll('[data-date]'), function (btn) {\r\n\t\t\t\tbtn.addEventListener('click', function () { pickDate(btn.getAttribute('data-date')); });\r\n\t\t\t});\r\n\t\t}\r\n\r\n\t\t\/* ---- slots ---- *\/\r\n\r\n\t\tfunction pickDate(date) {\r\n\t\t\tstate.date = date;\r\n\t\t\tstate.time = null;\r\n\t\t\tpaintMonth();\r\n\t\t\tpaintSteps();\r\n\t\t\thideAlert();\r\n\t\t\tel.form.hidden = true;\r\n\r\n\t\t\tel.slots.hidden = false;\r\n\t\t\tel.slots.innerHTML = '<div class=\"bbb-loading\"><span class=\"bbb-spin\"><\/span> Checking what is free\u2026<\/div>';\r\n\r\n\t\t\tapi('\/slots?date=' + encodeURIComponent(date)).then(function (day) {\r\n\t\t\t\tstate.day = day;\r\n\t\t\t\tpaintSlots(day);\r\n\t\t\t}).catch(function (e) {\r\n\t\t\t\tel.slots.innerHTML = '<p class=\"bbb-note\">' + esc(e.message) + '<\/p>';\r\n\t\t\t});\r\n\t\t}\r\n\r\n\t\tfunction paintSlots(day) {\r\n\t\t\tif (!day.open || !day.slots.length) {\r\n\t\t\t\tel.slots.innerHTML = '<h3>' + esc(day.label || '') + '<\/h3><p class=\"bbb-slots-sub\">' + esc(day.reason || 'No times are available on this day.') + '<\/p>';\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\r\n\t\t\tvar groups = { Morning: [], Afternoon: [], Evening: [] };\r\n\t\t\tday.slots.forEach(function (s) {\r\n\t\t\t\tvar hour = parseInt(s.time.split(':')[0], 10);\r\n\t\t\t\tvar key = hour < 12 ? 'Morning' : (hour < 17 ? 'Afternoon' : 'Evening');\r\n\t\t\t\tgroups[key].push(s);\r\n\t\t\t});\r\n\r\n\t\t\tvar html = '<h3>' + esc(day.label) + '<\/h3>' +\r\n\t\t\t\t'<p class=\"bbb-slots-sub\">' + (day.available\r\n\t\t\t\t\t? esc(day.available + (day.available === 1 ? ' time still free' : ' times still free') + '. Each appointment is ' + (C.minutes || 30) + ' minutes.')\r\n\t\t\t\t\t: esc(day.reason || '')) + '<\/p>';\r\n\r\n\t\t\tObject.keys(groups).forEach(function (name) {\r\n\t\t\t\tif (!groups[name].length) { return; }\r\n\t\t\t\thtml += '<div class=\"bbb-group\"><p class=\"bbb-group-t\">' + name + '<\/p><div class=\"bbb-times\">';\r\n\t\t\t\tgroups[name].forEach(function (s) {\r\n\t\t\t\t\thtml += '<button type=\"button\" class=\"bbb-time' + (s.time === state.time ? ' is-on' : '') + '\"' +\r\n\t\t\t\t\t\t' data-time=\"' + s.time + '\"' + (s.available ? '' : ' disabled') +\r\n\t\t\t\t\t\t' aria-pressed=\"' + (s.time === state.time ? 'true' : 'false') + '\"' +\r\n\t\t\t\t\t\t' aria-label=\"' + esc(s.label + (s.available ? ', available' : (s.reason === 'full' ? ', fully booked' : ', no longer available'))) + '\">' +\r\n\t\t\t\t\t\tesc(s.label) + '<\/button>';\r\n\t\t\t\t});\r\n\t\t\t\thtml += '<\/div><\/div>';\r\n\t\t\t});\r\n\r\n\t\t\tel.slots.innerHTML = html;\r\n\r\n\t\t\tArray.prototype.forEach.call(el.slots.querySelectorAll('[data-time]'), function (btn) {\r\n\t\t\t\tbtn.addEventListener('click', function () { pickTime(btn.getAttribute('data-time')); });\r\n\t\t\t});\r\n\t\t}\r\n\r\n\t\tfunction pickTime(time) {\r\n\t\t\tstate.time = time;\r\n\t\t\tpaintSlots(state.day);\r\n\t\t\tpaintSteps();\r\n\t\t\tel.form.hidden = false;\r\n\t\t\troot.querySelector('[data-bbb=\"chosen\"]').textContent = state.day.label + ' at ' + label(time);\r\n\t\t\ttry { el.form.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); } catch (e) { \/* older browsers *\/ }\r\n\t\t\tvar firstField = el.form.querySelector('input[name=\"name\"]');\r\n\t\t\t