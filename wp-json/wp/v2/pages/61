r\n\r\n\tfunction boot() {\r\n\t\tvar mounts = document.querySelectorAll('[data-bb-booking], .bb-booking-mount');\r\n\t\tvar forms = document.querySelectorAll('[data-bb-enquiry], .bb-enquiry-mount');\r\n\t\tfound += mounts.length + forms.length;\r\n\t\tArray.prototype.forEach.call(mounts, mountBooking);\r\n\t\tArray.prototype.forEach.call(forms, mountEnquiry);\r\n\t\treturn mounts.length + forms.length;\r\n\t}\r\n\r\n\tfunction watch() {\r\n\t\tif (!window.MutationObserver) { return; }\r\n\t\tvar observer = new MutationObserver(function () { boot(); });\r\n\t\tobserver.observe(document.body || document.documentElement, { childList: true, subtree: true });\r\n\t\t\/\/ Stop watching once the page has settled, so we are not observing forever.\r\n\t\tsetTimeout(function () { observer.disconnect(); }, 20000);\r\n\t}\r\n\r\n\tfunction start() {\r\n\t\tboot();\r\n\t\twatch();\r\n\r\n\t\t\/\/ Belt and braces: retry for ten seconds in case the container is\r\n\t\t\/\/ injected without a DOM mutation we can see.\r\n\t\tvar tries = 0;\r\n\t\tvar timer = setInterval(function () {\r\n\t\t\ttries++;\r\n\t\t\tif (boot() > 0 || tries > 20) {\r\n\t\t\t\tclearInterval(timer);\r\n\t\t\t\tif (!found && window.console) {\r\n\t\t\t\t\tconsole.warn('[Braces & Beyond] The booking script loaded but no mount point was found on this page. Check that the HTML widget still contains <div data-bb-booking><\/div> and that it was pasted into an HTML widget, not a Text Editor widget.');\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}, 500);\r\n\t}\r\n\r\n\tif (document.readyState === 'loading') {\r\n\t\tdocument.addEventListener('DOMContentLoaded', start);\r\n\t} else {\r\n\t\tstart();\r\n\t}\r\n\r\n\t\/\/ Manual hook, useful from the console or from another script.\r\n\twindow.BBBMount = boot;\r\n\tdocument.addEventListener('elementor\/popup\/show', boot);\r\n})();\r\n\r\n<\/script>\r\n\r\n<\/main>\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":