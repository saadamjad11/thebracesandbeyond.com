svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"oral-cancer-screening\" data-title=\"Oral Cancer Screening\" data-desc=\"A systematic check of the soft tissues of the mouth, tongue, floor of mouth and neck, carried out as part of a thorough examination.\" data-pts=\"Part of a full examination | Quick and painless | Early detection matters\" data-cat=\"Oral Medicine and Oral Pathology\" data-catn=\"07\" data-catid=\"oral-medicine-pathology\"><span data-svcname=\"\">Oral Cancer Screening<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"biopsy-histopathology\" data-title=\"Biopsy and Histopathological Assessment\" data-desc=\"Taking a tissue sample and having it examined under a microscope so a diagnosis is based on evidence rather than appearance alone.\" data-pts=\"Small sample taken locally | Laboratory examination | Findings explained clearly\" data-cat=\"Oral Medicine and Oral Pathology\" data-catn=\"07\" data-catid=\"oral-medicine-pathology\"><span data-svcname=\"\">Biopsy and Histopathological Assessment<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"oral-manifestations-systemic-disease\" data-title=\"Oral Manifestations of Systemic Diseases\" data-desc=\"Recognising signs in the mouth that relate to a wider health condition, and liaising with your doctor where that is appropriate.\" data-pts=\"Mouth signs taken seriously | Referral or liaison as needed | Shared care with your doctor\" data-cat=\"Oral Medicine and Oral Pathology\" data-catn=\"07\" data-catid=\"oral-medicine-pathology\"><span data-svcname=\"\">Oral Manifestations of Systemic Diseases<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"medication-related-oral-conditions\" data-title=\"Medication-Related Oral Conditions\" data-desc=\"Assessment of oral side effects linked to medication, including dry mouth, gum changes and effects on healing after surgery.\" data-pts=\"Full medication history taken | Dental risks explained | Care planned around your medicines\" data-cat=\"Oral Medicine and Oral Pathology\" data-catn=\"07\" data-catid=\"oral-medicine-pathology\"><span data-svcname=\"\">Medication-Related Oral Conditions<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<\/div>\r\n<\/div>\r\n<\/section>\r\n\r\n<!-- ===== 08. TMJ and Orofacial Pain ===== -->\r\n<section id=\"tmj-orofacial-pain\" data-svcsection=\"\" data-catid=\"tmj-orofacial-pain\" style=\"background:#F7F4EC;padding:clamp(48px,6vw,78px) 0;position:relative\">\r\n<div style=\"max-width:1340px;margin:0 auto;padding:0 24px\">\r\n<div data-reveal=\"\" data-cathead=\"\">\r\n<span data-catnum=\"\" data-reveal-child=\"\" aria-hidden=\"true\">08<\/span>\r\n<div data-reveal-child=\"\" style=\"flex:1 1 auto;min-width:0\">\r\n<h2 data-cattitle=\"\">TMJ and Orofacial Pain<\/h2>\r\n<div data-catmeta=\"\">\r\n<span data-catcount=\"\"><i class=\"fa-solid fa-spa\" style=\"font-size:12px;color:#C2A469\"><\/i>10 treatments<\/span>\r\n<\/div>\r\n<p data-catlead=\"\">Assessment and management of jaw joint problems, facial pain and clenching.<\/p>\r\n<span data-catrule=\"\" aria-hidden=\"true\"><\/span>\r\n<\/div>\r\n<\/div>\r\n<div data-svcgridx=\"\" data-reveal=\"\">\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"tmj-disorder-assessment\" data-title=\"TMJ Disorder Assessment\" data-desc=\"A structured assessment of the jaw joints and muscles, including movement, sounds, tenderness and how the teeth meet.\" data-pts=\"Movement and muscles examined | Bite assessed alongside | Imaging only when needed\" data-cat=\"TMJ and Orofacial Pain\" data-catn=\"08\" data-catid=\"tmj-orofacial-pain\"><span data-svcname=\"\">TMJ Disorder Assessment<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"myofascial-pain-management\" data-title=\"Myofascial Pain Management\" data-desc=\"Management of pain arising from the chewing muscles, usually starting with conservative measures and self care.\" data-pts=\"Conservative measures first | Jaw exercises and advice | Progress reviewed\" data-cat=\"TMJ and Orofacial Pain\" data-catn=\"08\" data-catid=\"tmj-orofacial-pain\"><span data-svcname=\"\">Myofascial Pain Management<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"jaw-pain-dysfunction\" data-title=\"Jaw Pain and Dysfunction\" data-desc=\"Investigation of jaw pain, tiredness on chewing and difficulty with normal jaw function, to identify what is driving it.\" data-pts=\"Cause identified before treatment | Habits and stress considered | Stepwise treatment plan\" data-cat=\"TMJ and Orofacial Pain\" data-catn=\"08\" data-catid=\"tmj-orofacial-pain\"><span data-svcname=\"\">Jaw Pain and Dysfunction<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"clicking-locking-jaw\" data-title=\"Clicking and Locking of the Jaw\" data-desc=\"Assessment of joint noises and episodes where the jaw catches or locks, and advice on what does and does not need treatment.\" data-pts=\"Not every click needs treatment | Locking assessed promptly | Clear self care guidance\" data-cat=\"TMJ and Orofacial Pain\" data-catn=\"08\" data-catid=\"tmj-orofacial-pain\"><span data-svcname=\"\">Clicking and Locking of the Jaw<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"bruxism-management\" data-title=\"Bruxism Management\" data-desc=\"Management of tooth grinding and clenching, protecting the teeth from wear while contributing factors are addressed.\" data-pts=\"Wear patterns recorded | Protective splint where indicated | Contributing factors reviewed\" data-cat=\"TMJ and Orofacial Pain\" data-catn=\"08\" data-catid=\"tmj-orofacial-pain\"><span data-svcname=\"\">Bruxism Management<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"occlusal-splints-night-guards\" data-title=\"Occlusal Splints and Night Guards\" data-desc=\"A custom made splint worn to protect teeth and reduce load on the jaw joints and muscles, usually at night.\" data-pts=\"Custom made to your bite | Protects teeth from wear | Fit checked and adjusted\" data-cat=\"TMJ and Orofacial Pain\" data-catn=\"08\" data-catid=\"tmj-orofacial-pain\"><span data-svcname=\"\">Occlusal Splints and Night Guards<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"tmd-headache\" data-title=\"Headache Associated with TMD\" data-desc=\"Assessment of headaches that appear linked to jaw muscle activity, managed alongside your doctor where necessary.\" data-pts=\"Pattern and triggers reviewed | Jaw and muscle examination | Medical liaison when needed\" data-cat=\"TMJ and Orofacial Pain\" data-catn=\"08\" data-catid=\"tmj-orofacial-pain\"><span data-svcname=\"\">Headache Associated with TMD<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"limited-mouth-opening\" data-title=\"Limited Mouth Opening Management\" data-desc=\"Investigation and management of restricted jaw opening, including exercises and treatment aimed at the underlying cause.\" data-pts=\"Opening measured and tracked | Cause investigated | Exercise programme provided\" data-cat=\"TMJ and Orofacial Pain\" data-catn=\"08\" data-catid=\"tmj-orofacial-pain\"><span data-svcname=\"\">Limited Mouth Opening Management<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"orofacial-pain-diagnosis\" data-title=\"Orofacial Pain Diagnosis\" data-desc=\"Careful diagnosis of facial pain, distinguishing dental causes from joint, muscle and nerve related causes.\" data-pts=\"Dental causes ruled out first | Structured pain history | Referral where appropriate\" data-cat=\"TMJ and Orofacial Pain\" data-catn=\"08\" data-catid=\"tmj-orofacial-pain\"><span data-svcname=\"\">Orofacial Pain Diagnosis<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"chronic-facial-pain\" data-title=\"Chronic Facial Pain Management\" data-desc=\"Longer term management of persistent facial pain, focused on function, comfort and realistic goals.\" data-pts=\"Realistic goals agreed | Regular review | Coordinated with other clinicians\" data-cat=\"TMJ and Orofacial Pain\" data-catn=\"08\" data-catid=\"tmj-orofacial-pain\"><span data-svcname=\"\">Chronic Facial Pain Management<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<\/div>\r\n<\/div>\r\n<\/section>\r\n\r\n<!-- ===== 09. Digital Dentistry ===== -->\r\n<section id=\"digital-dentistry\" data-svcsection=\"\" data-catid=\"digital-dentistry\" style=\"padding:clamp(48px,6vw,78px) 0;position:relative\">\r\n<div style=\"max-width:1340px;margin:0 auto;padding:0 24px\">\r\n<div data-reveal=\"\" data-cathead=\"\">\r\n<span data-catnum=\"\" data-reveal-child=\"\" aria-hidden=\"true\">09<\/span>\r\n<div data-reveal-child=\"\" style=\"flex:1 1 auto;min-width:0\">\r\n<h2 data-cattitle=\"\">Digital Dentistry<\/h2>\r\n<div data-catmeta=\"\">\r\n<span data-catcount=\"\"><i class=\"fa-solid fa-cube\" style=\"font-size:12px;color:#C2A469\"><\/i>13 treatments<\/span>\r\n<\/div>\r\n<p data-catlead=\"\">Scanning, planning and 3D fabrication that make treatment more precise and easier to explain.<\/p>\r\n<span data-catrule=\"\" aria-hidden=\"true\"><\/span>\r\n<\/div>\r\n<\/div>\r\n<div data-svcgridx=\"\" data-reveal=\"\">\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"intraoral-scanning\" data-title=\"Intraoral Scanning\" data-desc=\"A small camera records the shape of your teeth digitally, replacing conventional impression material for most procedures.\" data-pts=\"No impression trays | Comfortable and quick | Scan stored for comparison\" data-cat=\"Digital Dentistry\" data-catn=\"09\" data-catid=\"digital-dentistry\"><span data-svcname=\"\">Intraoral Scanning<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"digital-impressions\" data-title=\"Digital Impressions\" data-desc=\"Accurate digital records used to make aligners, retainers, crowns and other appliances without a physical impression.\" data-pts=\"Sent straight to the laboratory | Repeatable if needed | Reduces remakes\" data-cat=\"Digital Dentistry\" data-catn=\"09\" data-catid=\"digital-dentistry\"><span data-svcname=\"\">Digital Impressions<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"digital-smile-design\" data-title=\"Digital Smile Design\" data-desc=\"Photographs and scans are used to design and preview a proposed smile before any treatment begins.\" data-pts=\"See the plan before starting | Proportions studied carefully | A guide, not a guarantee\" data-cat=\"Digital Dentistry\" data-catn=\"09\" data-catid=\"digital-dentistry\"><span data-svcname=\"\">Digital Smile Design<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"3d-treatment-planning\" data-title=\"3D Treatment Planning\" data-desc=\"Treatment planned on a three dimensional model of your teeth, bone and, where relevant, your face.\" data-pts=\"Full three dimensional view | Options compared before starting | Shared with the whole team\" data-cat=\"Digital Dentistry\" data-catn=\"09\" data-catid=\"digital-dentistry\"><span data-svcname=\"\">3D Treatment Planning<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"cbct-diagnostics\" data-title=\"CBCT-Based Diagnostics\" data-desc=\"Three dimensional imaging used where a standard radiograph cannot answer the clinical question, taken only when justified.\" data-pts=\"Taken only when justified | Shows bone, roots and nerves | Reviewed with you\" data-cat=\"Digital Dentistry\" data-catn=\"09\" data-catid=\"digital-dentistry\"><span data-svcname=\"\">CBCT-Based Diagnostics<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"digital-orthodontic-setup\" data-title=\"Digital Orthodontic Setup\" data-desc=\"A digital simulation of planned tooth movement, used to check the target position before appliances are made.\" data-pts=\"Target position agreed early | Guides appliance design | Reviewed by the orthodontist\" data-cat=\"Digital Dentistry\" data-catn=\"09\" data-catid=\"digital-dentistry\"><span data-svcname=\"\">Digital Orthodontic Setup<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"virtual-surgical-planning\" data-title=\"Virtual Surgical Planning\" data-desc=\"Surgery rehearsed on a three dimensional model so movements and guides are decided before the operating day.\" data-pts=\"Surgery planned in advance | Guides made from the plan | Improves predictability\" data-cat=\"Digital Dentistry\" data-catn=\"09\" data-catid=\"digital-dentistry\"><span data-svcname=\"\">Virtual Surgical Planning<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"3d-printed-surgical-guides\" data-title=\"3D-Printed Surgical Guides\" data-desc=\"A printed guide that transfers the digital plan into the mouth, so implants or cuts follow the planned position.\" data-pts=\"Made from your own scan | Transfers the plan accurately | Single use and sterile\" data-cat=\"Digital Dentistry\" data-catn=\"09\" data-catid=\"digital-dentistry\"><span data-svcname=\"\">3D-Printed Surgical Guides<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"3d-printed-orthodontic-appliances\" data-title=\"3D-Printed Orthodontic Appliances\" data-desc=\"Appliances produced directly from digital files, giving a consistent fit and faster replacement if needed.\" data-pts=\"Consistent, repeatable fit | Faster to replace | Made from stored digital files\" data-cat=\"Digital Dentistry\" data-catn=\"09\" data-catid=\"digital-dentistry\"><span data-svcname=\"\">3D-Printed Orthodontic Appliances<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"digitally-fabricated-retainers\" data-title=\"Digitally Fabricated Retainers\" data-desc=\"Retainers made from your stored digital scan, so a replacement can be produced without taking new impressions.\" data-pts=\"Replacements without new scans | Consistent fit each time | Digital records kept\" data-cat=\"Digital Dentistry\" data-catn=\"09\" data-catid=\"digital-dentistry\"><span data-svcname=\"\">Digitally Fabricated Retainers<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"cad-cam-crowns-bridges\" data-title=\"CAD\/CAM Crowns, Bridges, Inlays and Onlays\" data-desc=\"Restorations designed on screen and manufactured precisely, with fit and contacts checked digitally before fitting.\" data-pts=\"Designed and milled precisely | Fit checked before fitting | Strong, tooth coloured materials\" data-cat=\"Digital Dentistry\" data-catn=\"09\" data-catid=\"digital-dentistry\"><span data-svcname=\"\">CAD\/CAM Crowns, Bridges, Inlays and Onlays<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"digital-denture-design\" data-title=\"Digital Denture Design\" data-desc=\"Dentures designed and produced digitally, with the design stored so an identical replacement can be made later.\" data-pts=\"Design stored for replacements | Fewer appointments in many cases | Predictable, repeatable result\" data-cat=\"Digital Dentistry\" data-catn=\"09\" data-catid=\"digital-dentistry\"><span data-svcname=\"\">Digital Denture Design<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"facial-scanning\" data-title=\"Facial Scanning and Virtual Patient Integration\" data-desc=\"Facial, dental and radiographic data combined into one virtual model, so treatment is planned against the whole face.\" data-pts=\"Teeth planned within the face | Useful for complex cases | Improves communication\" data-cat=\"Digital Dentistry\" data-catn=\"09\" data-catid=\"digital-dentistry\"><span data-svcname=\"\">Facial Scanning and Virtual Patient Integration<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<\/div>\r\n<\/div>\r\n<\/section>\r\n\r\n<!-- ===== 10. Craniofacial and Multidisciplinary Care ===== -->\r\n<section id=\"craniofacial-multidisciplinary\" data-svcsection=\"\" data-catid=\"craniofacial-multidisciplinary\" style=\"background:#F7F4EC;padding:clamp(48px,6vw,78px) 0;position:relative\">\r\n<div style=\"max-width:1340px;margin:0 auto;padding:0 24px\">\r\n<div data-reveal=\"\" data-cathead=\"\">\r\n<span data-catnum=\"\" data-reveal-child=\"\" aria-hidden=\"true\">10<\/span>\r\n<div data-reveal-child=\"\" style=\"flex:1 1 auto;min-width:0\">\r\n<h2 data-cattitle=\"\">Craniofacial and Multidisciplinary Care<\/h2>\r\n<div data-catmeta=\"\">\r\n<span data-catcount=\"\"><i class=\"fa-solid fa-diagram-project\" style=\"font-size:12px;color:#C2A469\"><\/i>12 treatments<\/span>\r\n<\/div>\r\n<p data-catlead=\"\">Complex cases that need several specialties working to one plan, coordinated over the long term.<\/p>\r\n<span data-catrule=\"\" aria-hidden=\"true\"><\/span>\r\n<\/div>\r\n<\/div>\r\n<div data-svcgridx=\"\" data-reveal=\"\">\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"craniofacial-anomaly-management\" data-title=\"Craniofacial Anomaly Management\" data-desc=\"Coordinated care for congenital and developmental craniofacial conditions, staged around growth over many years.\" data-pts=\"Care staged around growth | One coordinated plan | Long term relationship\" data-cat=\"Craniofacial and Multidisciplinary Care\" data-catn=\"10\" data-catid=\"craniofacial-multidisciplinary\"><span data-svcname=\"\">Craniofacial Anomaly Management<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"syndromic-craniofacial-conditions\" data-title=\"Syndromic Craniofacial Conditions\" data-desc=\"Dental and orthodontic care for patients with a diagnosed syndrome, planned with realistic, individual goals.\" data-pts=\"Individual goals set together | Function prioritised | Team based decisions\" data-cat=\"Craniofacial and Multidisciplinary Care\" data-catn=\"10\" data-catid=\"craniofacial-multidisciplinary\"><span data-svcname=\"\">Syndromic Craniofacial Conditions<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"craniofacial-growth-assessment\" data-title=\"Craniofacial Growth Assessment\" data-desc=\"Serial records and analysis that show how the face and jaws are growing, so treatment is timed rather than rushed.\" data-pts=\"Serial records over time | Timing guided by growth | Records kept for comparison\" data-cat=\"Craniofacial and Multidisciplinary Care\" data-catn=\"10\" data-catid=\"craniofacial-multidisciplinary\"><span data-svcname=\"\">Craniofacial Growth Assessment<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"multidisciplinary-treatment-planning\" data-title=\"Multidisciplinary Treatment Planning\" data-desc=\"A joint plan agreed between the clinicians involved, with a clear order of treatment and one point of contact for you.\" data-pts=\"Joint clinical discussion | Clear order of stages | One plan you can follow\" data-cat=\"Craniofacial and Multidisciplinary Care\" data-catn=\"10\" data-catid=\"craniofacial-multidisciplinary\"><span data-svcname=\"\">Multidisciplinary Treatment Planning<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"ortho-orthognathic-coordination\" data-title=\"Orthodontic and Orthognathic Surgery Coordination\" data-desc=\"Braces and jaw surgery sequenced together, with each stage planned around the other from the start.\" data-pts=\"Planned jointly from day one | Preparation before surgery | Finishing after surgery\" data-cat=\"Craniofacial and Multidisciplinary Care\" data-catn=\"10\" data-catid=\"craniofacial-multidisciplinary\"><span data-svcname=\"\">Orthodontic and Orthognathic Surgery Coordination<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"speech-swallowing-assessment\" data-title=\"Speech and Swallowing Assessment\" data-desc=\"Referral and coordination for speech and swallowing assessment, since jaw and palate conditions can affect both.\" data-pts=\"Referral where indicated | Findings feed the dental plan | Reviewed as treatment progresses\" data-cat=\"Craniofacial and Multidisciplinary Care\" data-catn=\"10\" data-catid=\"craniofacial-multidisciplinary\"><span data-svcname=\"\">Speech and Swallowing Assessment<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"ent-collaboration\" data-title=\"ENT Collaboration\" data-desc=\"Joint working with ear, nose and throat colleagues where airway, sinus or ear concerns interact with dental treatment.\" data-pts=\"Airway concerns considered | Shared clinical information | Coordinated appointments\" data-cat=\"Craniofacial and Multidisciplinary Care\" data-catn=\"10\" data-catid=\"craniofacial-multidisciplinary\"><span data-svcname=\"\">ENT Collaboration<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"pediatric-consultation\" data-title=\"Pediatric Consultation\" data-desc=\"Liaison with paediatric colleagues for children whose care involves growth, general health or a diagnosed condition.\" data-pts=\"Whole child considered | General health taken into account | Shared decision making\" data-cat=\"Craniofacial and Multidisciplinary Care\" data-catn=\"10\" data-catid=\"craniofacial-multidisciplinary\"><span data-svcname=\"\">Pediatric Consultation<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"plastic-reconstructive-collaboration\" data-title=\"Plastic and Reconstructive Surgery Collaboration\" data-desc=\"Coordination with reconstructive surgical colleagues where soft tissue and facial reconstruction form part of the plan.\" data-pts=\"Shared surgical planning | Sequenced with dental stages | Clear communication throughout\" data-cat=\"Craniofacial and Multidisciplinary Care\" data-catn=\"10\" data-catid=\"craniofacial-multidisciplinary\"><span data-svcname=\"\">Plastic and Reconstructive Surgery Collaboration<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"craniofacial-maxillofacial-surgery\" data-title=\"Maxillofacial Surgery\" data-desc=\"The surgical element of craniofacial care, delivered in stages and reviewed against the agreed overall plan.\" data-pts=\"Delivered in planned stages | Reviewed against the plan | Recovery supported\" data-cat=\"Craniofacial and Multidisciplinary Care\" data-catn=\"10\" data-catid=\"craniofacial-multidisciplinary\"><span data-svcname=\"\">Maxillofacial Surgery<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"craniofacial-prosthodontic-rehabilitation\" data-title=\"Prosthodontic Rehabilitation\" data-desc=\"Replacing missing teeth and structures after surgery or in a developmental condition, restoring function and appearance.\" data-pts=\"Restores function first | Appearance planned carefully | Adjusted as things change\" data-cat=\"Craniofacial and Multidisciplinary Care\" data-catn=\"10\" data-catid=\"craniofacial-multidisciplinary\"><span data-svcname=\"\">Prosthodontic Rehabilitation<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"long-term-craniofacial-followup\" data-title=\"Long-Term Craniofacial Follow-Up\" data-desc=\"Continuing review after active treatment, because craniofacial care is measured in years rather than months.\" data-pts=\"Review continues after treatment | Records updated each visit | Care over years, not months\" data-cat=\"Craniofacial and Multidisciplinary Care\" data-catn=\"10\" data-catid=\"craniofacial-multidisciplinary\"><span data-svcname=\"\">Long-Term Craniofacial Follow-Up<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<\/div>\r\n<\/div>\r\n<\/section>\r\n\r\n<!-- ===== 11. Dental Emergency Services ===== -->\r\n<section id=\"dental-emergency\" data-svcsection=\"\" data-catid=\"dental-emergency\" style=\"padding:clamp(48px,6vw,78px) 0;position:relative\">\r\n<div style=\"max-width:1340px;margin:0 auto;padding:0 24px\">\r\n<div data-reveal=\"\" data-cathead=\"\">\r\n<span data-catnum=\"\" data-reveal-child=\"\" aria-hidden=\"true\">11<\/span>\r\n<div data-reveal-child=\"\" style=\"flex:1 1 auto;min-width:0\">\r\n<h2 data-cattitle=\"\">Dental Emergency Services<\/h2>\r\n<div data-catmeta=\"\">\r\n<span data-catcount=\"\"><i class=\"fa-solid fa-clock\" style=\"font-size:12px;color:#C2A469\"><\/i>10 treatments<\/span>\r\n<\/div>\r\n<p data-catlead=\"\">Prompt assessment and relief when something goes wrong and cannot wait.<\/p>\r\n<span data-catrule=\"\" aria-hidden=\"true\"><\/span>\r\n<\/div>\r\n<\/div>\r\n<div data-svcgridx=\"\" data-reveal=\"\">\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"emergency-toothache\" data-title=\"Emergency Toothache Management\" data-desc=\"Assessment of severe or persistent toothache to find the cause and relieve it, rather than treating the pain alone.\" data-pts=\"Cause identified, not just masked | Relief at the same visit where possible | Definitive treatment planned after\" data-cat=\"Dental Emergency Services\" data-catn=\"11\" data-catid=\"dental-emergency\"><span data-svcname=\"\">Emergency Toothache Management<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"dental-abscess\" data-title=\"Dental Abscess Management\" data-desc=\"Treatment of a dental infection with swelling, including drainage and definitive treatment of the tooth involved.\" data-pts=\"Assessed urgently | Drainage where indicated | Spreading swelling needs same day care\" data-cat=\"Dental Emergency Services\" data-catn=\"11\" data-catid=\"dental-emergency\"><span data-svcname=\"\">Dental Abscess Management<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"emergency-root-canal\" data-title=\"Emergency Root Canal Treatment\" data-desc=\"Opening and cleaning an infected tooth to relieve severe pain, with the treatment completed at a planned later appointment.\" data-pts=\"Relieves acute pain | Completed at a later visit | Tooth restored afterwards\" data-cat=\"Dental Emergency Services\" data-catn=\"11\" data-catid=\"dental-emergency\"><span data-svcname=\"\">Emergency Root Canal Treatment<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"emergency-dental-trauma\" data-title=\"Dental Trauma Management\" data-desc=\"Immediate care after an injury to the teeth or mouth, including repositioning and splinting where that is needed.\" data-pts=\"Time matters after injury | Repositioning and splinting | Follow up to monitor the tooth\" data-cat=\"Dental Emergency Services\" data-catn=\"11\" data-catid=\"dental-emergency\"><span data-svcname=\"\">Dental Trauma Management<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"fractured-broken-teeth\" data-title=\"Fractured and Broken Teeth\" data-desc=\"Assessment and repair of a broken tooth, from a chipped edge to a fracture that involves the nerve.\" data-pts=\"Extent of the fracture assessed | Temporary or definitive repair | Nerve health monitored\" data-cat=\"Dental Emergency Services\" data-catn=\"11\" data-catid=\"dental-emergency\"><span data-svcname=\"\">Fractured and Broken Teeth<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"lost-restorations\" data-title=\"Lost or Fallen Restorations\" data-desc=\"Replacing or recementing a crown, bridge, veneer or filling that has come out, and checking why it failed.\" data-pts=\"Bring the restoration with you | Reason for failure checked | Recemented or remade\" data-cat=\"Dental Emergency Services\" data-catn=\"11\" data-catid=\"dental-emergency\"><span data-svcname=\"\">Lost or Fallen Restorations<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"post-operative-emergencies\" data-title=\"Post-Operative Dental Emergencies\" data-desc=\"Care for problems after a procedure, such as bleeding, a dry socket or unexpected pain during healing.\" data-pts=\"Contact us rather than wait | Assessed and treated promptly | Aftercare reviewed\" data-cat=\"Dental Emergency Services\" data-catn=\"11\" data-catid=\"dental-emergency\"><span data-svcname=\"\">Post-Operative Dental Emergencies<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"acute-dental-infection\" data-title=\"Acute Dental Infection Management\" data-desc=\"Management of spreading dental infection, including antibiotics where clinically indicated and treatment of the source.\" data-pts=\"Source of infection treated | Antibiotics only when indicated | Urgent if breathing or swallowing is affected\" data-cat=\"Dental Emergency Services\" data-catn=\"11\" data-catid=\"dental-emergency\"><span data-svcname=\"\">Acute Dental Infection Management<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"emergency-extractions\" data-title=\"Emergency Extractions\" data-desc=\"Removal of a tooth that cannot be saved and is causing pain or infection, after the alternatives have been explained.\" data-pts=\"Alternatives explained first | Carried out under local anaesthesia | Replacement options discussed later\" data-cat=\"Dental Emergency Services\" data-catn=\"11\" data-catid=\"dental-emergency\"><span data-svcname=\"\">Emergency Extractions<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"soft-tissue-injury\" data-title=\"Soft-Tissue Injury Management\" data-desc=\"Treatment of cuts and injuries to the lips, cheeks, tongue and gums, including cleaning and suturing where needed.\" data-pts=\"Wound cleaned and assessed | Sutures where needed | Healing reviewed\" data-cat=\"Dental Emergency Services\" data-catn=\"11\" data-catid=\"dental-emergency\"><span data-svcname=\"\">Soft-Tissue Injury Management<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<\/div>\r\n<\/div>\r\n<\/section>\r\n\r\n<!-- ===== 12. Dental Trauma and Rehabilitation ===== -->\r\n<section id=\"dental-trauma\" data-svcsection=\"\" data-catid=\"dental-trauma\" style=\"background:#F7F4EC;padding:clamp(48px,6vw,78px) 0;position:relative\">\r\n<div style=\"max-width:1340px;margin:0 auto;padding:0 24px\">\r\n<div data-reveal=\"\" data-cathead=\"\">\r\n<span data-catnum=\"\" data-reveal-child=\"\" aria-hidden=\"true\">12<\/span>\r\n<div data-reveal-child=\"\" style=\"flex:1 1 auto;min-width:0\">\r\n<h2 data-cattitle=\"\">Dental Trauma and Rehabilitation<\/h2>\r\n<div data-catmeta=\"\">\r\n<span data-catcount=\"\"><i class=\"fa-solid fa-shield-halved\" style=\"font-size:12px;color:#C2A469\"><\/i>9 treatments<\/span>\r\n<\/div>\r\n<p data-catlead=\"\">Immediate care after injury, then the longer job of rebuilding and monitoring the teeth involved.<\/p>\r\n<span data-catrule=\"\" aria-hidden=\"true\"><\/span>\r\n<\/div>\r\n<\/div>\r\n<div data-svcgridx=\"\" data-reveal=\"\">\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"fractured-teeth\" data-title=\"Fractured Teeth\" data-desc=\"Assessment of how deep a fracture runs, which decides whether a simple repair, a crown or nerve treatment is needed.\" data-pts=\"Depth of fracture assessed | Treatment matched to the damage | Reviewed over following months\" data-cat=\"Dental Trauma and Rehabilitation\" data-catn=\"12\" data-catid=\"dental-trauma\"><span data-svcname=\"\">Fractured Teeth<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"avulsed-teeth\" data-title=\"Avulsed Teeth\" data-desc=\"Care for a tooth that has been knocked completely out. This is genuinely time critical, so contact the clinic immediately.\" data-pts=\"Time critical, call at once | Keep the tooth moist, handle by the crown | Splinted and monitored\" data-cat=\"Dental Trauma and Rehabilitation\" data-catn=\"12\" data-catid=\"dental-trauma\"><span data-svcname=\"\">Avulsed Teeth<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"luxated-teeth\" data-title=\"Luxated Teeth\" data-desc=\"Treatment of teeth that have been pushed out of position by an injury, including repositioning and stabilising them.\" data-pts=\"Repositioned as soon as possible | Splinted while healing | Nerve health followed up\" data-cat=\"Dental Trauma and Rehabilitation\" data-catn=\"12\" data-catid=\"dental-trauma\"><span data-svcname=\"\">Luxated Teeth<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"root-fractures\" data-title=\"Root Fractures\" data-desc=\"Diagnosis and management of fractures within the root, which need imaging to locate and careful monitoring afterwards.\" data-pts=\"Located with radiographs | Often splinted | Long term monitoring\" data-cat=\"Dental Trauma and Rehabilitation\" data-catn=\"12\" data-catid=\"dental-trauma\"><span data-svcname=\"\">Root Fractures<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"childrens-traumatic-injuries\" data-title=\"Traumatic Dental Injuries in Children\" data-desc=\"Injury care for children, taking into account developing teeth and the adult tooth forming underneath.\" data-pts=\"Developing teeth considered | Gentle, explained treatment | Longer follow up period\" data-cat=\"Dental Trauma and Rehabilitation\" data-catn=\"12\" data-catid=\"dental-trauma\"><span data-svcname=\"\">Traumatic Dental Injuries in Children<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"dental-splinting\" data-title=\"Dental Splinting\" data-desc=\"Stabilising injured or loosened teeth with a splint for a defined period so the supporting tissues can heal.\" data-pts=\"Holds teeth while healing | Worn for a set period | Removed and reassessed\" data-cat=\"Dental Trauma and Rehabilitation\" data-catn=\"12\" data-catid=\"dental-trauma\"><span data-svcname=\"\">Dental Splinting<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"restoration-traumatized-teeth\" data-title=\"Restoration of Traumatized Teeth\" data-desc=\"Rebuilding the shape, function and appearance of injured teeth once the immediate phase has settled.\" data-pts=\"Done once healing settles | Shade and shape matched | May be staged over time\" data-cat=\"Dental Trauma and Rehabilitation\" data-catn=\"12\" data-catid=\"dental-trauma\"><span data-svcname=\"\">Restoration of Traumatized Teeth<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"endodontic-management-trauma\" data-title=\"Endodontic Management Following Trauma\" data-desc=\"Root canal treatment where an injury has damaged the nerve, sometimes needed months after the original accident.\" data-pts=\"Nerve tested at each review | May be needed later, not at once | Preserves the natural tooth\" data-cat=\"Dental Trauma and Rehabilitation\" data-catn=\"12\" data-catid=\"dental-trauma\"><span data-svcname=\"\">Endodontic Management Following Trauma<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"trauma-aesthetic-prosthetic-rehabilitation\" data-title=\"Aesthetic and Prosthetic Rehabilitation\" data-desc=\"Longer term restoration after trauma, including crowns, bridges or implants where a tooth cannot be saved.\" data-pts=\"Planned once the site is stable | Appearance and function together | Options compared openly\" data-cat=\"Dental Trauma and Rehabilitation\" data-catn=\"12\" data-catid=\"dental-trauma\"><span data-svcname=\"\">Aesthetic and Prosthetic Rehabilitation<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<\/div>\r\n<\/div>\r\n<\/section>\r\n\r\n<!-- ===== 13. Aesthetic and Cosmetic Dentistry ===== -->\r\n<section id=\"aesthetic-dentistry\" data-svcsection=\"\" data-catid=\"aesthetic-dentistry\" style=\"padding:clamp(48px,6vw,78px) 0;position:relative\">\r\n<div style=\"max-width:1340px;margin:0 auto;padding:0 24px\">\r\n<div data-reveal=\"\" data-cathead=\"\">\r\n<span data-catnum=\"\" data-reveal-child=\"\" aria-hidden=\"true\">13<\/span>\r\n<div data-reveal-child=\"\" style=\"flex:1 1 auto;min-width:0\">\r\n<h2 data-cattitle=\"\">Aesthetic and Cosmetic Dentistry<\/h2>\r\n<div data-catmeta=\"\">\r\n<span data-catcount=\"\"><i class=\"fa-solid fa-wand-magic-sparkles\" style=\"font-size:12px;color:#C2A469\"><\/i>9 treatments<\/span>\r\n<\/div>\r\n<p data-catlead=\"\">Elective treatment focused on how your smile looks, always planned on a healthy foundation.<\/p>\r\n<span data-catrule=\"\" aria-hidden=\"true\"><\/span>\r\n<\/div>\r\n<\/div>\r\n<div data-svcgridx=\"\" data-reveal=\"\">\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"cosmetic-digital-smile-design\" data-title=\"Digital Smile Design\" data-desc=\"Designing the proposed smile digitally from photographs and scans, so you can see and discuss it before treatment starts.\" data-pts=\"Preview before you commit | Proportions planned carefully | A design guide, not a guarantee\" data-cat=\"Aesthetic and Cosmetic Dentistry\" data-catn=\"13\" data-catid=\"aesthetic-dentistry\"><span data-svcname=\"\">Digital Smile Design<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"porcelain-composite-veneers\" data-title=\"Porcelain and Composite Veneers\" data-desc=\"Thin facings bonded to the front of teeth to change shape, shade or alignment. Porcelain and composite differ in longevity, cost and how much tooth is prepared.\" data-pts=\"Preparation kept minimal | Porcelain or composite compared | Trial smile where suitable\" data-cat=\"Aesthetic and Cosmetic Dentistry\" data-catn=\"13\" data-catid=\"aesthetic-dentistry\"><span data-svcname=\"\">Porcelain and Composite Veneers<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"cosmetic-teeth-whitening\" data-title=\"Teeth Whitening\" data-desc=\"Supervised whitening carried out after the health of the teeth and gums has been checked. Existing crowns and fillings do not change shade.\" data-pts=\"Health checked first | Existing restorations do not lighten | Sensitivity managed\" data-cat=\"Aesthetic and Cosmetic Dentistry\" data-catn=\"13\" data-catid=\"aesthetic-dentistry\"><span data-svcname=\"\">Teeth Whitening<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"smile-makeovers\" data-title=\"Smile Makeovers\" data-desc=\"A combined plan that may include orthodontics, whitening, bonding, veneers or crowns, sequenced in the right order.\" data-pts=\"One plan, several treatments | Correct order matters | Costs set out in advance\" data-cat=\"Aesthetic and Cosmetic Dentistry\" data-catn=\"13\" data-catid=\"aesthetic-dentistry\"><span data-svcname=\"\">Smile Makeovers<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"gum-contouring\" data-title=\"Gum Contouring\" data-desc=\"Reshaping the gum line so it frames the teeth evenly, often the difference between a good and a very good result.\" data-pts=\"Evens an uneven gum line | Healing before final work | Planned with restorations\" data-cat=\"Aesthetic and Cosmetic Dentistry\" data-catn=\"13\" data-catid=\"aesthetic-dentistry\"><span data-svcname=\"\">Gum Contouring<\/span><span data-svcplus=\"\" aria-hidden=\"true\">+<\/span><\/button>\r\n<button type=\"button\" data-svcitem=\"\" aria-haspopup=\"dialog\" data-slug=\"cosmetic-crown-lengthening\" data-title=\"Crown Lengthening\" data-desc=\"Adjusting the gum and bone level to show more of the tooth, used for a gummy smile or to allow a restoration to fit properly.\" data-pts=\"Aesthetic or functional reasons | Small surgical procedure | Healing time before restoring\" data-cat=\"Aesthetic and Cosmetic Dentistry\" data