      if (id === current) return;\r\n        current = id;\r\n        chips.forEach(function(c){\r\n          if (c.getAttribute('data-chipfor') === id){\r\n            c.setAttribute('data-active','');\r\n            var cr = c.getBoundingClientRect(), rr = strip.getBoundingClientRect();\r\n            if (cr.left < rr.left + 44 || cr.right > rr.right - 44){\r\n              strip.scrollTo({left: strip.scrollLeft + (cr.left - rr.left) - 60, behavior:'smooth'});\r\n            }\r\n          } else {\r\n            c.removeAttribute('data-active');\r\n          }\r\n        });\r\n      };\r\n      var io = new IntersectionObserver(function(entries){\r\n        entries.forEach(function(en){ live[en.target.getAttribute('data-catid')] = en.isIntersecting; });\r\n        paint();\r\n      }, {rootMargin:'-45% 0px -45% 0px', threshold:0});\r\n      socks.forEach(function(sec){ io.observe(sec); });\r\n      window.addEventListener('scroll', paint, {passive:true});\r\n    }\r\n  }\r\n\r\n  \/* --------------------------------------------------------------- filter *\/\r\n  function norm(s){ return (s || '').toLowerCase().replace(\/[^a-z0-9 ]+\/g, ' ').replace(\/\\s+\/g, ' ').trim(); }\r\n\r\n  items.forEach(function(b){\r\n    b.__hay = norm(b.getAttribute('data-title') + ' ' + b.getAttribute('data-cat') + ' ' + b.getAttribute('data-desc'));\r\n  });\r\n\r\n  function filter(q){\r\n    var term = norm(q), shown = 0, alive = {};\r\n    items.forEach(function(b){\r\n      var hit = !term || b.__hay.indexOf(term) > -1;\r\n      b.hidden = !hit;\r\n      if (hit){ shown++; alive[b.getAttribute('data-catid')] = true; }\r\n    });\r\n    socks.forEach(function(s){ s.hidden = !!term && !alive[s.getAttribute('data-catid')]; });\r\n    chips.forEach(function(c){\r\n      if (term && !alive[c.getAttribute('data-chipfor')]) c.setAttribute('data-empty','');\r\n      else c.removeAttribute('data-empty');\r\n    });\r\n    if (empty) empty.hidden = shown > 0;\r\n    if (clear) clear.hidden = !term;\r\n    if (count) count.textContent = term\r\n      ? (shown + (shown === 1 ? ' treatment matches' : ' treatments match') + ' \"' + q.trim() + '\"')\r\n      : ('Showing all ' + total + ' treatments');\r\n  }\r\n\r\n  if (search){\r\n    var t;\r\n    search.addEventListener('input', function(){\r\n      window.clearTimeout(t);\r\n      t = window.setTimeout(function(){ filter(search.value); }, 120);\r\n    });\r\n    search.addEventListener('keydown', function(e){ if (e.key === 'Escape'){ search.value = ''; filter(''); } });\r\n  }\r\n  function resetAll(){ if (search) search.value = ''; filter(''); if (search) search.focus(); }\r\n  if (clear) clear.addEventListener('click', resetAll);\r\n  if (reset) reset.addEventListener('click', resetAll);\r\n\r\n  \/* ------------------------------------------------- open from a deep link\r\n     \/our-services\/#svc-clear-aligners opens that treatment popup directly.\r\n     A plain category anchor such as #orthodontics is left to the browser. *\/\r\n  function fromHash(){\r\n    var h = (window.location.hash || '').replace('#', '');\r\n    if (h.indexOf('svc-') !== 0) return;\r\n    var slug = h.slice(4);\r\n    var btn = items.filter(function(b){ return b.getAttribute('data-slug') === slug; })[0];\r\n    if (btn){\r\n      var sec = document.getElementById(btn.getAttribute('data-catid'));\r\n      if (sec) sec.scrollIntoView({block:'start'});\r\n      window.setTimeout(function(){ open(btn); }, 400);\r\n    }\r\n  }\r\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fromHash);\r\n  else fromHash();\r\n  window.addEventListener('hashchange', fromHash);\r\n})();\r\n<\/script>\r\n\r\n<\/main>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-f42d8e3 elementor-widget elementor-widget-html\" data-id=\"f42d8e3\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t\t<!-- Braces & Beyond - OUR SERVICES: specialty index upgrade\r\n     ============================================================\r\n     WHERE THIS GOES\r\n     Paste this whole block into a NEW Elementor HTML widget placed\r\n     immediately AFTER your existing our-services.html widget on the\r\n     same page. Do not edit our-services.html at all.\r\n\r\n     Order on the page:\r\n       header.html  ->  our-services.html  ->  THIS FILE  ->  footer.html\r\n\r\n     WHAT IT DOES\r\n       1. Removes the grey horizontal scrollbar under the specialty chips.\r\n          The row still scrolls, the browser chrome is simply gone.\r\n       2. Wraps the chip row in a rail with soft fade edges and two round\r\n          arrow buttons, so it is obvious the row continues sideways.\r\n       3. Highlights the chip for the specialty you are currently reading\r\n            and keeps that chip scrolled into view.\r\n       4. Tidies the index bar: aligned search, count pushed right, even\r\n          chip heights, calmer spacing.\r\n     Everything is additive and namespaced to [data-bbchip*] \/ [data-bbsvc].\r\n     Delete this widget and the page returns exactly to how it was.\r\n-->\r\n<div data-bbchipfix=\"\">\r\n<style>\r\n\/* ---------- 1. the scrollbar itself, gone on every engine ---------- *\/\r\n[data-bbsvc] [data-svcchips]{\r\n  scrollbar-width:none !important;\r\n  -ms-overflow-style:none !important;\r\n  scroll-behavior:smooth;\r\n  padding:6px 2px 8px !important;\r\n  gap:10px !important;\r\n  overscroll-behavior-x:contain;\r\n}\r\n[data-bbsvc] [data-svcchips]::-webkit-scrollbar{\r\n  width:0 !important;height:0 !important;display:none !important;\r\n}\r\n[data-bbsvc] [data-svcchips]::-webkit-scrollbar-thumb,\r\n[data-bbsvc] [data-svcchips]::-webkit-scrollbar-track{\r\n  background:transparent !important;\r\n}\r\n\r\n\/* ---------- 2. the rail: fade edges + arrows ---------- *\/\r\n[data-bbsvc] [data-bbchiprail]{position:relative;min-width:0}\r\n\/* the fades sit above the chips but never eat a click *\/\r\n[data-bbsvc] [data-bbchiprail]:before,\r\n[data-bbsvc] [data-bbchiprail]:after{\r\n  content:\"\";position:absolute;top:0;bottom:0;width:64px;z-index:2;\r\n  pointer-events:none;opacity:0;transition:opacity .3s ease;\r\n}\r\n[data-bbsvc] [data-bbchiprail]:before{\r\n  left:0;background:linear-gradient(90deg,#FAF8F2 8%,rgba(250,248,242,0) 100%);\r\n}\r\n[data-bbsvc] [data-bbchiprail]:after{\r\n  right:0;background:linear-gradient(270deg,#FAF8F2 8%,rgba(250,248,242,0) 100%);\r\n}\r\n[data-bbsvc] [data-bbchiprail][data-more~=\"left\"]:before{opacity:1}\r\n[data-bbsvc] [data-bbchiprail][data-more~=\"right\"]:after{opacity:1}\r\n\r\n[data-bbsvc] [data-bbchipnav]{\r\n  position:absolute;top:50%;transform:translateY(-50%);z-index:3;\r\n  display:none;align-items:center;justify-content:center;\r\n  width:34px;height:34px;border-radius:999px;\r\n  background:#FFFDF7;border:1px solid #E8E1CE;color:#576045;\r\n  font-size:11px;cursor:pointer;padding:0;\r\n  box-shadow:0 10px 22px -14px rgba(35,36,31,.7);\r\n  transition:background .25s,color .25s,border-color .25s,transform .25s,opacity .25s;\r\n}\r\n[data-bbsvc] [data-bbchipnav]:hover{background:#576045;color:#FAF8F2;border-color:#576045}\r\n[data-bbsvc] [data-bbchipnav]:focus-visible{outline:2px solid #576045;outline-offset:3px}\r\n[data-bbsvc] [data-bbchipnav=\"prev\"]{left:-4px}\r\n[data-bbsvc] [data-bbchipnav=\"next\"]{right:-4px}\r\n[data-bbsvc] [data-bbchiprail][data-more~=\"left\"] [data-bbchipnav=\"prev\"],\r\n[data-bbsvc] [data-bbchiprail][data-more~=\"right\"] [data-bbchipnav=\"next\"]{display:flex}\r\n\/* pointer devices only: on a phone you just swipe *\/\r\n@media (hover:none),(max-width:760px){\r\n  [data-bbsvc] [data-bbchipnav]{display:none !important}\r\n  [data-bbsvc] [data-bbchiprail]:before,\r\n  [data-bbsvc] [data-bbchiprail]:after{width:34px}\r\n}\r\n@media (min-width:761px){\r\n  [data-bbsvc] [data-bbchiprail][data-more~=\"left\"] [data-svcchips]{padding-left:40px !important}\r\n  [data-bbsvc] [data-bbchiprail][data-more~=\"right\"] [data-svcchips]{padding-right:40px !important}\r\n}\r\n\r\n\/* ---------- 3. chips: even heights, calmer type, live state ---------- *\/\r\n[data-bbsvc] [data-svcchip]{\r\n  min-height:40px;\r\n  padding:11px 17px !important;\r\n  border-radius:999px !important;\r\n  scroll-margin:24px;\r\n}\r\n[data-bbsvc] [data-svcchip] b{\r\n  font-size:9.5px !important;letter-spacing:.16em !important;\r\n}\r\n[data-bbsvc] [data-svcchip][data-active]{\r\n  background:#576045 !important;color:#FAF8F2 !important;border-color:#576045 !important;\r\n  box-shadow:0 12px 24px -16px rgba(87,96,69,.95);\r\n}\r\n[data-bbsvc] [data-svcchip][data-active] b{color:#D9C79B !important}\r\n\r\n\/* ---------- 4. the index bar itself ---------- *\/\r\n[data-bbsvc] [data-svcindex]{box-shadow:0 14px 26px -26px rgba(35,36,31,.55)}\r\n[data-bbsvc] [data-svccount]{margin-left:auto;white-space:nowrap}\r\n@media (max-width:760px){\r\n  [data-bbsvc] [data-svccount]{margin-left:0;width:100%}\r\n}\r\n<\/style>\r\n\r\n<script>\r\n(function(){\r\n  if (window.__bbChipRail) return; window.__bbChipRail = true;\r\n\r\n  function boot(){\r\n    var root = document.querySelector('[data-bbsvc]');\r\n    if (!root) return;\r\n    var chips = root.querySelector('[data-svcchips]');\r\n    if (!chips || chips.parentNode.hasAttribute('data-bbchiprail')) return;\r\n\r\n    \/* --- build the rail around the existing chip row --- *\/\r\n    var rail = document.createElement('div');\r\n    rail.setAttribute('data-bbchiprail','');\r\n    chips.parentNode.insertBefore(rail, chips);\r\n    rail.appendChild(chips);\r\n\r\n    function navBtn(dir, glyph, label){\r\n      var b = document.createElement('button');\r\n      b.type = 'button';\r\n      b.setAttribute('data-bbchipnav', dir);\r\n      b.setAttribute('aria-label', label);\r\n      b.innerHTML = '<i class=\"fa-solid fa-chevron-' + glyph + '\" aria-hidden=\"true\"><\/i>';\r\n      b.addEventListener('click', function(){\r\n        chips.scrollBy({left: (dir === 'prev' ? -1 : 1) * Math.round(chips.clientWidth * .72), behavior:'smooth'});\r\n      });\r\n      rail.appendChild(b);\r\n      return b;\r\n    }\r\n    navBtn('prev','left','Scroll specialties left');\r\n    navBtn('next','right','Scroll specialties right');\r\n\r\n    \/* --- which edges still have content --- *\/\r\n    function edges(){\r\n      var max = chips.scrollWidth - chips.clientWidth;\r\n      var x = chips.scrollLeft, s = [];\r\n      if (x > 4) s.push('left');\r\n      if (x < max - 4) s.push('right');\r\n      rail.setAttribute('data-more', s.join(' '));\r\n    }\r\n    chips.addEventListener('scroll', edges, {passive:true});\r\n    window.addEventListener('resize', edges);\r\n    edges();\r\n    window.setTimeout(edges, 400);\r\n\r\n    \/* --- highlight the specialty currently on screen --- *\/\r\n    var secs = Array.prototype.slice.call(root.querySelectorAll('[data-svcsection]'));\r\n    var list = Array.prototype.slice.call(root.querySelectorAll('[data-svcchip]'));\r\n    if (!secs.length || !list.length || !('IntersectionObserver' in window)) return;\r\n\r\n    var live = {}, current = null;\r\n\r\n    function paint(){\r\n      var id = null, best = 1e9;\r\n      secs.forEach(function(sec){\r\n        var key = sec.getAttribute('data-catid');\r\n        if (!live[key] || sec.hidden) return;\r\n        var top = Math.abs(sec.getBoundingClientRect().top);\r\n        if (top < best){ best = top; id = key; }\r\n      });\r\n      if (id === current) return;\r\n      current = id;\r\n      list.forEach(function(c){\r\n        var on = c.getAttribute('data-chipfor') === id;\r\n        if (on){\r\n          c.setAttribute('data-active','');\r\n          \/* keep the active chip in view without yanking the page *\/\r\n          var cr = c.getBoundingClientRect(), rr = chips.getBoundingClientRect();\r\n          if (cr.left < rr.left + 40 || cr.right > rr.right - 40){\r\n            chips.scrollTo({left: chips.scrollLeft + (cr.left - rr.left) - 60, behavior:'smooth'});\r\n          }\r\n        } else {\r\n          c.removeAttribute('data-active');\r\n        }\r\n      });\r\n    }\r\n\r\n    var io = new IntersectionObserver(function(entries){\r\n      entries.forEach(function(en){\r\n        live[en.target.getAttribute('data-catid')] = en.isIntersecting;\r\n      });\r\n      paint();\r\n    }, {rootMargin: '-45% 0px -45% 0px', threshold: 0});\r\n    secs.forEach(function(sec){ io.observe(sec); });\r\n\r\n    window.addEventListener('scroll', paint, {passive:true});\r\n  }\r\n\r\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);\r\n  else boot();\r\n})();\r\n<\/script>\r\n<\/div>\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>Our Services Fourteen Specialties.One Clinical Team. Orthodontics is where we started. Alongside it, Braces &amp; Beyond offers 172 treatments across surgical, restorative, paediatric and diagnostic care. Select any treatment below to read what it involves. Book a Consultation &#8594; Ask a Question 14Areas of care 172Treatments listed 1Coordinated team Search treatments Clear Showing all 172 [&hellip;]<\/p>\n","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"elementor_header_footer","meta":{"footnotes":""},"class_list":["post-37","page","type-page","status-publish","hentry"],"_hostinger_reach_plugin_has_subscription_block":false,"_hostinger_reach_plugin_is_elementor":false,"_links":{"self":[{"href":"https:\/\/thebracesandbeyond.com\/wp-json\/wp\/v2\/pages\/37","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/thebracesandbeyond.com\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/thebracesandbeyond.com\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/thebracesandbeyond.com\/wp-json\/wp\/v2\/users\/1"}],"replie